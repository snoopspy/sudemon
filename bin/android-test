#!/bin/sh

output=$(adb shell '[ -f /system/bin/sudemon ] && echo "exists" || echo "not found"' 2>&1)
if echo "$output" | grep -i -q "no devices"; then
    echo $output
    exit
elif [ "$output" = "exists" ]; then
    echo "sudemon installed"
else
    echo "sudemon not installed"
    exit
fi

output=$(adb shell su -c whoami 2>&1)
# echo 'output='$output #

if echo "$output" | grep -i -q "root"; then
    echo "sudemon running"
    exit
else
    echo "sudemon not running"
fi
